{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "Worker": {
    "Enabled": false,
    "DiscoveryIntervalMinutes": 360,
    "CloseCaptureIntervalMinutes": 60,
    "RunOnStartup": false
  },
  "Copart": {
    "Headless": true,
    "PageSize": 100,
    "MaxPages": 50,
    "MinDelayMs": 1500,
    "MaxDelayMs": 4000,
    "ProxyServer": null
  },
  "Collection": {
    "Targets": [
      {
        "make": "BMW",
        "model": "3 Series",
        "yearFrom": 2020,
        "sources": [ "Copart" ],
        "enabled": true
      }
    ],
    "MaxPagesPerSearch": 50
  }
}
